# Copy this to .env.local and fill in your values

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.perfmonk.in

# Resend — email delivery (required for contact form emails)
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Firebase — stores contact form submissions in Firestore (server-side only)
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Paste the ENTIRE JSON as a single-line value (server-side only — never exposed).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Google Sheets — appends contact submissions to a spreadsheet
# 1. Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. Enable the Google Sheets API at https://console.cloud.google.com/apis/library/sheets.googleapis.com
# 3. Download the JSON key and copy client_email → GOOGLE_SERVICE_ACCOUNT_EMAIL
# 4. Copy private_key → GOOGLE_PRIVATE_KEY (keep the quotes, \n is fine)
# 5. Create a Google Sheet, share it with the service account email (Editor)
# 6. Copy the sheet ID from the URL → GOOGLE_SHEET_ID
# 7. Add headers in row 1: Timestamp | Name | Email | Company | Message | Demo
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id-from-url

# ── Firestore setup ──────────────────────────────────────────────────────────
# No schema needed — the route writes to the `contact_submissions` collection and
# Firestore creates it on first write. The server uses the Admin SDK (service
# account), which bypasses security rules, so the default locked rules are fine.
# ─────────────────────────────────────────────────────────────────────────────
